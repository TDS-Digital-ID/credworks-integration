{
  "openapi": "3.1.0",
  "info": {
    "title": "Education sign-in example",
    "version": "0.1.0",
    "description": "Application/session API. Credential protocols remain in the separately operated partner runtime. Synthetic demo; public delivery acknowledgement is not sign-in."
  },
  "servers": [
    {
      "url": "https://app.example",
      "description": "Replace with configured EDUCATION_APP_ORIGIN"
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "summary": "Create/read protected browser session and CSRF token",
        "responses": {
          "200": {
            "description": "Secure HttpOnly SameSite cookie for new browser; csrf/status and optional application account_id. Never student ID or credential claims."
          }
        },
        "tags": [
          "Browser application"
        ]
      }
    },
    "/api/interactions": {
      "post": {
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "browserCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile"
                ],
                "properties": {
                  "profile": {
                    "enum": [
                      "education_sign_in",
                      "education_eligibility"
                    ]
                  }
                }
              },
              "examples": {
                "education_eligibility": {
                  "summary": "Education eligibility",
                  "value": {
                    "profile": "education_eligibility"
                  },
                  "description": "Uses the current browser cookie, exact Origin and CSRF token. Runtime credentials remain on the server."
                },
                "education_sign_in": {
                  "summary": "Education sign in",
                  "value": {
                    "profile": "education_sign_in"
                  },
                  "description": "Uses the current browser cookie, exact Origin and CSRF token. Runtime credentials remain on the server."
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed input or mismatched result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Browser missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CSRF, verification or policy refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Interaction belongs to another browser or route missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pending or consumed interaction, retired browser",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Expired interaction or evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds4KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Application or runtime unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Public activation only. Runtime management and result capabilities remain server-side.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "profile",
                    "activation_uri",
                    "request_uri",
                    "expires_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "profile": {
                      "type": "string"
                    },
                    "activation_uri": {
                      "type": "string"
                    },
                    "request_uri": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expires_at": {
                      "type": "number"
                    }
                  }
                },
                "examples": {
                  "created": {
                    "summary": "Interaction created",
                    "value": {
                      "id": "sssssssssssssssssssssssssssssssssssssssssss",
                      "profile": "education_eligibility",
                      "activation_uri": "openid4vp://authorize?client_id=decentralized_identifier%3Adid%3Aweb%3Averifier.example&request_uri=https%3A%2F%2Fverifier.example%2Foid4vp%2Frequest%2Frrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr",
                      "request_uri": "https://verifier.example/oid4vp/request/rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr",
                      "expires_at": 1793318520
                    },
                    "description": "Public activation details only. No runtime management token or correlation capability is exposed."
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Browser application"
        ]
      }
    },
    "/api/interactions/{id}/complete": {
      "post": {
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "security": [
          {
            "browserCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              },
              "examples": {
                "complete": {
                  "summary": "Complete the original interaction",
                  "value": {},
                  "description": "Use the same initiating browser and current CSRF token."
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed input or mismatched result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Browser missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CSRF, verification or policy refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "policyRefused": {
                    "summary": "Not currently enrolled",
                    "value": {
                      "error": {
                        "code": "ENROLMENT_REQUIRED"
                      }
                    },
                    "description": "Verification alone does not grant access. Application enrolment policy refused this result."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Interaction belongs to another browser or route missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Pending or consumed interaction, retired browser",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "pending": {
                    "summary": "Awaiting wallet",
                    "value": {
                      "error": {
                        "code": "RESULT_PENDING"
                      }
                    },
                    "description": "Wait before retrying the same interaction and keep the original deadline. RUNTIME_UNAVAILABLE is also retryable before application effects start."
                  }
                }
              }
            }
          },
          "410": {
            "description": "Expired interaction or evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "expired": {
                    "summary": "Interaction expired",
                    "value": {
                      "error": {
                        "code": "INTERACTION_EXPIRED"
                      }
                    },
                    "description": "Create a new interaction. The reference client does not extend the request lifetime."
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds4KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Application or runtime unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "runtimeUnavailable": {
                    "summary": "Runtime response unavailable",
                    "value": {
                      "error": {
                        "code": "RUNTIME_UNAVAILABLE"
                      }
                    },
                    "description": "No application callback has started. Retry the same interaction after about one second, within the original limits. APPLICATION_UNAVAILABLE may indicate uncertain application effects and must not be treated the same way."
                  }
                }
              }
            }
          },
          "200": {
            "description": "Application decision after fresh protected result. Sign-in rotates cookie; eligibility creates no account.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "account_id"
                      ],
                      "properties": {
                        "status": {
                          "const": "signed_in"
                        },
                        "account_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "eligible"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "eligible": {
                    "summary": "Eligibility accepted",
                    "value": {
                      "status": "eligible"
                    },
                    "description": "Application policy passed. This does not create an account."
                  },
                  "signedIn": {
                    "summary": "Student signed in",
                    "value": {
                      "status": "signed_in",
                      "account_id": "12345678-1234-4234-8234-123456789abc"
                    },
                    "description": "Application policy passed and the browser session was rotated. The account ID is synthetic."
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Browser application"
        ],
        "description": "Completes the original browser-bound interaction once. RESULT_PENDING permits waiting for wallet completion. RUNTIME_UNAVAILABLE permits another completion attempt because no application callback has started; retry with the same browser, CSRF token and interaction, one call at a time. Retrieval is bounded by the original request expires_at + 120, evidence validity and browser validity. A validated refusal or any started application callback is terminal. A lost browser completion response is not an acknowledgement protocol: check /api/session for sign-in state before starting again."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-education"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              }
            }
          }
        }
      }
    }
  }
}
