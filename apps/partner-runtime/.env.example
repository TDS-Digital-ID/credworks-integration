PARTNER_ORIGIN=https://partner.example
PARTNER_STATE_DIR=/absolute/protected/path/partner-identity
# Inject a persistent 32-byte random unpadded base64url secret; never a password.
PARTNER_UNLOCK_KEY=
# Inject a distinct random management credential of at least 32 bytes.
PARTNER_MANAGEMENT_TOKEN=
PARTNER_PUBLIC_PORT=3080
PARTNER_MANAGEMENT_PORT=3081

# Optional public pinned Education or scalar verifier configuration; omit during identity registration.
# Scalar example: examples/scalar-verifier.json. Use separate persistent issuer/verifier identities.
PARTNER_VERIFIER_CONFIG=
